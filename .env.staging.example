# Shared-server settings template; replace placeholders in an uncommitted .env.staging.
# Copy this file to .env.staging on the Hetzner server. Never commit the real file.
COMPOSE_PROJECT_NAME=spc-staging
NGINX_HTTP_PORT=80
DEBUG=false

POSTGRES_DB=spc
POSTGRES_USER=spc_backend
POSTGRES_PASSWORD=replace_with_a_long_random_database_password

SECRET_KEY=replace_with_at_least_32_random_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
WEBSOCKET_TICKET_EXPIRE_SECONDS=60
REDIS_PASSWORD=replace_with_a_long_random_redis_password

# Private uploaded-note storage shared by the API and processing worker.
NOTE_STORAGE_DIRECTORY=/app/storage/notes
MAX_NOTE_UPLOAD_SIZE_BYTES=10485760
MAX_CHAT_QUESTION_LENGTH=4000

# Configure these after the external custom-model inference endpoint is selected.
INFERENCE_API_URL=
INFERENCE_API_KEY=
