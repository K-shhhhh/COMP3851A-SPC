# Public browser configuration. Never put provider keys or database passwords here.
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=
VITE_USE_MOCKS=true
VITE_MOCK_DELAY_MS=800

# Vite development proxy only; not exposed to the browser and not used by Docker builds.
# Default is the local Docker gateway. For native FastAPI use http://127.0.0.1:8000.
DEV_API_PROXY_TARGET=http://127.0.0.1:8080
