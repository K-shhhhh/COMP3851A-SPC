# Repository-root Compose settings template; copy to .env and keep real secrets out of Git.
POSTGRES_DB=spc
POSTGRES_USER=spc_backend
POSTGRES_PASSWORD=replace_with_a_local_password

PGADMIN_EMAIL=admin@spc.example.com
PGADMIN_PASSWORD=replace_with_a_local_password

SECRET_KEY=replace_with_a_long_random_local_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
REFRESH_SESSION_COOKIE_NAME=spc_refresh_session
# Local HTTP development only. Staging defaults to secure cookies because DEBUG=false.
REFRESH_SESSION_COOKIE_SECURE=false
REFRESH_SESSION_COOKIE_SAMESITE=lax
WEBSOCKET_TICKET_EXPIRE_SECONDS=60
DEBUG=true
NGINX_HTTP_PORT=8080
PRESENCE_TTL_SECONDS=90

# Institutional account verification. Console delivery prints a code only in
# local backend logs; use SMTP in staging/production.
INSTITUTIONAL_EMAIL_RESTRICTION_ENABLED=true
INSTITUTIONAL_EMAIL_ALLOWLIST=
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_DELIVERY_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_STARTTLS=true

# Private uploaded-note storage shared by the API and processing worker.
NOTE_STORAGE_DIRECTORY=/app/storage/notes
EVIDENCE_STORAGE_DIRECTORY=/app/storage/evidence
MAX_NOTE_UPLOAD_SIZE_BYTES=10485760
MAX_CHAT_QUESTION_LENGTH=4000

# React integration mode. Local Docker defaults to mocks while backend, DB and
# model services are being developed. Hetzner staging overrides mocks to false.
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=
VITE_USE_MOCKS=true
VITE_MOCK_DELAY_MS=800

# Configure these when a custom-model inference provider is selected.
INFERENCE_API_URL=
INFERENCE_API_KEY=
# Chat model for AI answers. Leave empty to use meta-llama/llama-3.1-8b-instruct.
# Example for a bigger model: meta-llama/llama-3.3-70b-instruct
CHAT_MODEL=
ENABLE_KNOWLEDGE_GRAPH_GENERATION=false
ENABLE_DATABASE_SEMANTIC_SEARCH=true
RAG_SEMANTIC_SEARCH_TOP_K=5
